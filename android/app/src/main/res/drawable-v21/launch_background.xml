<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the Flutter splash gradient so there is no white flash on start. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="290" android:startColor="#B8E4F9" android:centerColor="#3AB0E8" android:endColor="#0E8FD6" />
        </shape>
    </item>
</layer-list>
